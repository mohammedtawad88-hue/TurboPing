{
  "name": "turboping",
  "version": "1.0.0",
  "description": "Ultra-fast gaming network latency optimizer and ping reducer for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "gaming",
    "ping-booster",
    "exitlag-alternative",
    "network-optimizer",
    "nagle-algorithm",
    "dns-benchmark"
  ],
  "author": "TurboPing Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.turboping.app",
    "productName": "TurboPing",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TurboPing"
    }
  }
}
